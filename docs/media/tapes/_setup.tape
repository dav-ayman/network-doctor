# shared settings (sourced by each tape)
Set Shell "bash"
Set FontSize 17
Set Width 1280
Set Padding 26
Set Theme "GitHub Dark"
Set TypingSpeed 45ms
Set WindowBar Colorful
Hide
Type "export PS1='$ ' NETDOC_HOME=$(mktemp -d); alias netdoc='python3 plugins/network-doctor/skills/network-doctor/scripts/netdoc.py'; clear"
Enter
Show
